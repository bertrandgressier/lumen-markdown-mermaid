{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Paris",
  "schedule": ["before 10am on Monday"],
  "packageRules": [
    {
      "description": "dependencies + devDependencies: bump to latest, tests validate compat",
      "matchPackageNames": ["@tanstack/markdown", "mermaid", "react", "react-dom", "@types/react", "@types/react-dom", "@testing-library/react", "jsdom"],
      "matchDepTypes": ["dependencies", "devDependencies"],
      "rangeStrategy": "bump",
      "groupName": "deps"
    },
    {
      "description": "peerDependencies: only widen when a release falls outside the range, never raise the minimum",
      "matchPackageNames": ["@tanstack/markdown", "react"],
      "matchDepTypes": ["peerDependencies"],
      "rangeStrategy": "widen"
    },
    {
      "description": "tooling: TS + test runner in one PR, majors included, CI validates",
      "matchPackageNames": ["typescript", "vitest"],
      "matchDepTypes": ["devDependencies"],
      "groupName": "tooling",
      "rangeStrategy": "bump",
      "separateMajorMinor": false
    },
    {
      "description": "ignore everything else",
      "matchPackageNames": ["!@tanstack/markdown", "!mermaid", "!react", "!react-dom", "!@types/react", "!@types/react-dom", "!@testing-library/react", "!jsdom", "!typescript", "!vitest"],
      "enabled": false
    }
  ]
}
